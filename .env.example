# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres connection string (pooled connection recommended).
# Get this from the Neon dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/yachtassist?sslmode=require"

# Shared password for the /admin route (fuel price + article edits). Phase 2 replaces this with real auth.
ADMIN_PASSWORD="change-me"

# Public contact email shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
